# Supabase → Project Settings → API
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...   # Supabase secret key: server only, never commit or expose

# Optional: browser origins allowed to call the API cross-origin (same-origin on Vercel needs none)
CORS_ORIGINS=

# Bearer token required for write/import endpoints
ADMIN_TOKEN=change-me-to-a-long-random-string

# Optional: public address for set-password links (default: Vercel production domain, else http://localhost:3000)
SITE_URL=
# Optional: also email set-password links via Resend (EMAIL_FROM must be on a domain verified in Resend)
RESEND_API_KEY=
EMAIL_FROM=

PORT=4000
